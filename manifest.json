{
  "manifest_version": 3,
  "name": "TAU Login Automator",
  "version": "1.0",
  "description": "Autofills login credentials for the university website and submits the form.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://nidp.tau.ac.il/nidp/idff/sso*"],
      "js": ["script.js"]
    }
  ]
}
